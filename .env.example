# Repository root; relative paths below resolve from this root.
OMNISEARCH_ROOT=.

# Validated Phase 21/22 local artifact locations.
OMNISEARCH_PHASE20_REPORT=artifacts/phase20/phase20_report.json
OMNISEARCH_PHASE20_RECOMMENDATIONS=artifacts/phase20/recommended_configurations.json
OMNISEARCH_PHASE20_PROVENANCE=artifacts/phase20/provenance.json
OMNISEARCH_CHECKPOINT=artifacts/phase7/best_checkpoint.pt
OMNISEARCH_MANIFEST=data/processed/coco2017_val_split_manifest.json
OMNISEARCH_IMAGE_ROOT=data/raw/coco2017/val2017
OMNISEARCH_CACHE_DIR=artifacts/phase10/embedding_cache
OMNISEARCH_IMAGE_INDEX=artifacts/phase10/indexes/tier3/text_to_image/faiss_flat.faiss
OMNISEARCH_IMAGE_INDEX_METADATA=artifacts/phase10/indexes/tier3/text_to_image/faiss_flat.metadata.json
OMNISEARCH_CAPTION_INDEX=artifacts/phase10/indexes/tier3/image_to_text/faiss_flat.faiss
OMNISEARCH_CAPTION_INDEX_METADATA=artifacts/phase10/indexes/tier3/image_to_text/faiss_flat.metadata.json

# Deployment settings.
OMNISEARCH_DEVICE=auto
OMNISEARCH_MAX_QUERY_CHARS=1000
OMNISEARCH_MAX_UPLOAD_BYTES=10485760
OMNISEARCH_MAX_IMAGE_PIXELS=40000000
OMNISEARCH_HOST=127.0.0.1
OMNISEARCH_API_PORT=8000
OMNISEARCH_UI_PORT=8501

# Set to 1 after the Hugging Face model is cached locally.
OMNISEARCH_OFFLINE=1

# macOS-only FAISS/PyTorch compatibility workaround; harmless elsewhere.
OMNISEARCH_OPENMP_WORKAROUND=1
